; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Red Card"
config/description="First-person football referee. The game knows the truth. Get it right."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.051, 0.066, 1)
config/icon="res://assets/icon.png"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
scaling_3d/scale=0.8
anti_aliasing/quality/screen_space_aa=1
; Ambient occlusion is what stops everything on the pitch looking like it hovers a
; centimetre above it, but at the default quality it cost a third of the frame rate at the
; National Stadium — 60 fps down to the high forties. At half resolution and low quality it
; costs almost nothing and, at the distance a referee stands from the grass, looks the same.
environment/ssao/quality=0
environment/ssao/half_size=true
environment/ssao/adaptive_target=0.3
